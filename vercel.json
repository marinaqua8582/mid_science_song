{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/gemini/generate-lyrics",
      "destination": "/api/gemini/generate-lyrics"
    },
    {
      "source": "/api/gas-code",
      "destination": "/api/gas-code"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
